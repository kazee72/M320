        <mxCell id="legend" value="&lt;b&gt;Legende&lt;/b&gt;&lt;br&gt;gefuellte Raute = Komposition (ganz-teil, existenzabhaengig)&lt;br&gt;Linie = Assoziation&lt;br&gt;Farben: orange = Kompositionsteil, blau = unabhaengige Klasse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="520" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;Begruendung Kompositionen&lt;/b&gt;&lt;br&gt;Bestellung / Bestellposition: Mindestens eine Position; Positionen koennen nicht unabhaengig von der Bestellung existieren und werden beim Loeschen mitgeloescht.&lt;br&gt;Bestellung / Lieferadresse: Wird beim Erstellen der Bestellung als eigener Bestandteil gespeichert und mit der Bestellung geloescht.&lt;br&gt;Bestellung / Zahlung: Hoestens eine Zahlung (0..1); sie gehoert immer genau zu einer Bestellung und existiert nie unabhaengig davon.&lt;br&gt;&lt;b&gt;Assoziationen&lt;/b&gt; Kunde / Bestellung: Kunde existiert unabhaengig (beliebig viele Bestellungen, 0..*). Bestellposition / Produkt: Produkt bleibt beim Loeschen der Bestellung erhalten (0..*)." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="700" height="160" as="geometry"/></mxCell>
